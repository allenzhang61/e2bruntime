@@ -0,0 +1,20 @@
+'use client'
+import { useQuery } from '@tanstack/react-query'
+import type { CellContext } from '@tanstack/react-table'
+import Link from 'next/link'
+import type { SandboxListRow } from '@/features/dashboard/sandboxes/list/table-config'
+
+export function SnapshotCountCell({ row }: CellContext<SandboxListRow, unknown>) {
+  const query = useQuery<{ counts: Record<string, number> }>({
+    queryKey: ['s3-snapshot-counts'],
+    queryFn: async () => {
+      const response = await fetch('/api/backups')
+      if (!response.ok) throw new Error('Snapshot storage unavailable')
+      return response.json()
+    }, staleTime: 10000, refetchInterval: 15000,
+  })
+  if (query.isError) return <span title="Snapshot storage unavailable">Unavailable</span>
+  if (!query.data) return <span aria-label="Loading snapshot count">…</span>
+  const count = query.data.counts[row.original.sandboxID] ?? 0
+  return <Link href={`/snapshots/${encodeURIComponent(row.original.sandboxID)}`} onClick={(event) => event.stopPropagation()} className="font-mono underline underline-offset-4" aria-label={`${count} snapshots for ${row.original.sandboxID}`}>{count}</Link>
+}
diff --git a/src/features/dashboard/snapshots/snapshot-list.tsx b/src/features/dashboard/snapshots/snapshot-list.tsx
