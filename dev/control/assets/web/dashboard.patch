@@ -0,0 +1,30 @@
+import { NextResponse } from 'next/server'
+import { getApiKey } from '@/core/server/auth'
+
+export async function GET(request: Request) {
+  const apiKey = await getApiKey()
+  if (!apiKey) return NextResponse.json({ error: 'Sign in required' }, { status: 401 })
+  const params = new URL(request.url).searchParams
+  const sandboxId = params.get('sandboxId')
+  const archiveKey = params.get('archiveKey')
+  if (archiveKey && !sandboxId) return NextResponse.json({ error: 'Instance ID required' }, { status: 400 })
+  if (sandboxId && !/^[a-zA-Z0-9_-]+$/.test(sandboxId)) {
+    return NextResponse.json({ error: 'Invalid instance ID' }, { status: 400 })
+  }
+  const endpoint = process.env.E2B_BACKUP_API_URL || 'http://127.0.0.1:3012'
+  const url = new URL(archiveKey ? '/metadata' : '/snapshots', endpoint)
+  if (sandboxId) url.searchParams.set('sandboxId', sandboxId)
+  if (archiveKey) url.searchParams.set('archiveKey', archiveKey)
+  try {
+    const response = await fetch(url, {
+      headers: { 'X-API-Key': apiKey }, cache: 'no-store',
+      signal: AbortSignal.timeout(20000),
+    })
+    if (!response.ok) {
+      return NextResponse.json({ error: response.status === 401 ? 'Not authorized for this backup store' : response.status === 404 ? 'No Metadata for this backup' : 'Snapshot storage unavailable' }, { status: response.status })
+    }
+    return NextResponse.json(await response.json(), { headers: { 'Cache-Control': 'no-store' } })
+  } catch {
+    return NextResponse.json({ error: 'Snapshot storage unavailable' }, { status: 502 })
+  }
+}
