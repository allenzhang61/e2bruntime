@@ -0,0 +1,36 @@
+'use client'
+import { useQuery } from '@tanstack/react-query'
+import Link from 'next/link'
+import { Button } from '@/ui/primitives/button'
+
+type Snapshot = { key: string; bytes: number; backupAt: string; storedAt: string; kind: string; metadataKey?: string; metadataBytes?: number }
+export function SnapshotList({ sandboxId }: { sandboxId: string }) {
+  const query = useQuery<{ snapshots: Snapshot[]; count: number; node: string }>({
+    queryKey: ['s3-snapshots', sandboxId],
+    queryFn: async () => {
+      const response = await fetch(`/api/backups?sandboxId=${encodeURIComponent(sandboxId)}`)
+      if (!response.ok) throw new Error('Unable to load snapshots. Check backup storage and access.')
+      return response.json()
+    }, refetchInterval: 15000,
+  })
+  return <div className="flex h-full flex-col gap-5 overflow-auto p-6">
+    <Link href="/sandboxes" className="text-sm underline">← Sandboxes</Link>
+    <div className="flex items-center justify-between gap-4">
+      <div><h1 className="text-xl font-semibold">Instance snapshots</h1><p className="mt-2 font-mono text-sm">{sandboxId}</p></div>
+      <Button variant="secondary" onClick={() => query.refetch()} disabled={query.isFetching}>Refresh</Button>
+    </div>
+    <p className="text-sm text-fg-muted">Filesystem backups retained in S3, newest first. Shared base layers and local hibernation state are excluded.</p>
+    {query.isError ? <p role="alert">{query.error.message}</p> : !query.data ? <p>Loading snapshots…</p> : <>
+      <p>{query.data.count} snapshots · {query.data.node}</p>
+      {query.data.count === 0 ? <p>No snapshots yet.</p> : <div className="overflow-x-auto rounded border border-stroke"><table className="w-full text-left text-sm">
+        <thead><tr className="border-b border-stroke"><th className="p-3">Backup time (UTC)</th><th className="p-3">Type</th><th className="p-3 text-right">Size (bytes)</th><th className="p-3">Object name</th><th className="p-3">Metadata</th></tr></thead>
+        <tbody>{query.data.snapshots.map((snapshot) => <tr key={snapshot.key} className="border-b border-stroke last:border-b-0">
+          <td className="whitespace-nowrap p-3 font-mono">{snapshot.backupAt.replace('T', ' ').replace('Z', '')}</td>
+          <td className="p-3">Filesystem</td><td className="p-3 text-right font-mono">{snapshot.bytes.toLocaleString()}</td>
+          <td className="p-3 font-mono break-all">{snapshot.key}</td>
+          <td className="whitespace-nowrap p-3">{snapshot.metadataKey ? <div className="flex flex-col gap-1"><Link className="underline" title={snapshot.metadataKey} href={`/snapshots/${sandboxId}/metadata?archiveKey=${encodeURIComponent(snapshot.key)}`}>View JSON</Link><span className="text-xs text-fg-muted">{snapshot.metadataBytes?.toLocaleString()} bytes</span></div> : <span className="text-fg-muted">无 Metadata</span>}</td>
+        </tr>)}</tbody>
+      </table></div>}
+    </>}
+  </div>
+}
