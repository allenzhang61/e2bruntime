@@ -0,0 +1,31 @@
+'use client'
+import { useQuery } from '@tanstack/react-query'
+import Link from 'next/link'
+import { Button } from '@/ui/primitives/button'
+
+type MetadataResponse = { metadataKey: string; metadata: Record<string, unknown> }
+export function MetadataView({ sandboxId, archiveKey }: { sandboxId: string; archiveKey: string }) {
+  const query = useQuery<MetadataResponse>({
+    queryKey: ['s3-backup-metadata', sandboxId, archiveKey],
+    queryFn: async () => {
+      const response = await fetch(`/api/backups?sandboxId=${encodeURIComponent(sandboxId)}&archiveKey=${encodeURIComponent(archiveKey)}`)
+      if (!response.ok) {
+        const body = await response.json().catch(() => ({}))
+        throw new Error(body.error || 'Unable to load Metadata')
+      }
+      return response.json()
+    }, retry: false,
+  })
+  return <div className="flex h-full flex-col gap-5 overflow-auto p-6">
+    <Link href={`/snapshots/${sandboxId}`} className="text-sm underline">← Backup list</Link>
+    <div className="flex items-center justify-between gap-4">
+      <div><h1 className="text-xl font-semibold">Backup Metadata</h1><p className="mt-2 font-mono text-sm">{sandboxId}</p></div>
+      <Button variant="secondary" onClick={() => query.refetch()} disabled={query.isFetching}>Refresh</Button>
+    </div>
+    <p className="text-sm text-fg-muted">Separate S3 JSON object for this filesystem backup.</p>
+    {query.isError ? <p role="alert">{query.error.message}</p> : !query.data ? <p>Loading Metadata…</p> : <>
+      <p className="break-all font-mono text-sm">{query.data.metadataKey}</p>
+      <pre className="overflow-x-auto rounded border border-stroke p-4 text-sm">{JSON.stringify(query.data.metadata, null, 2)}</pre>
+    </>}
+  </div>
+}
