+import { notFound } from 'next/navigation'
+import { MetadataView } from '@/features/dashboard/snapshots/metadata-view'
+
+export default async function MetadataPage({ params, searchParams }: {
+  params: Promise<{ sandboxId: string }>
+  searchParams: Promise<{ archiveKey?: string }>
+}) {
+  const { sandboxId } = await params
+  const { archiveKey } = await searchParams
+  if (!/^[a-zA-Z0-9_-]+$/.test(sandboxId) || typeof archiveKey !== 'string' || !archiveKey) notFound()
+  return <MetadataView sandboxId={sandboxId} archiveKey={archiveKey} />
+}
