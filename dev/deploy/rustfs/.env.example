# First deploy creates .env with random AK/SK automatically. These are examples only.
RUSTFS_IMAGE=rustfs/rustfs:latest
RUSTFS_BIND_IP=192.168.1.211
RUSTFS_ENDPOINT=http://192.168.1.211:19000
RUSTFS_ACCESS_KEY=YOUR_GENERATED_ACCESS_KEY
RUSTFS_SECRET_KEY=YOUR_GENERATED_SECRET_KEY
RUSTFS_BUCKET_NAME=runtime-snapshots
RUSTFS_REGION=us-east-1
