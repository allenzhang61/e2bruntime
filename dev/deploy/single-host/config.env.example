# Shell configuration, sourced on the Linux host. Never put credentials here.
E2BRUNTIME_WORK=$HOME/e2bruntime-single
E2BRUNTIME_REPO=git@github.com:allenzhang61/e2bruntime.git
E2BRUNTIME_REF=HEAD
CONTROL_LISTEN=127.0.0.1:13021
CONTROL_URL=http://127.0.0.1:13021
CONTROL_ALLOWED_HOSTS=
RUNTIME1_WEB_URL=http://127.0.0.1:13001
WEB_ADMIN_LISTEN=127.0.0.1:13001
WEB_ADMIN_ORIGINS="http://127.0.0.1:13021 http://localhost:13021"
PUBLIC_SANDBOX_URL=http://127.0.0.1:3002
# Existing S3 credentials remain on the server, in a shell environment file.
S3_ENV=$HOME/rustfs/.env
RUSTFS_ENDPOINT=http://127.0.0.1:9100
RUSTFS_BUCKET_NAME=runtime-snapshots
RUSTFS_REGION=us-east-1
# Optional machine-specific preflight, checked only when installing Runtime.
REQUIRED_MOUNT=
