# Each node has a unique name to isolate object prefixes.
BACKUP_NODE=runtime1
BACKUP_API_URL=http://127.0.0.1:3000
BACKUP_PROXY_URL=http://127.0.0.1:3002
BACKUP_STORAGE_ROOT=/var/lib/e2b/storage/templates
BACKUP_INTERVAL=2m
BACKUP_KEEP=10

# Cross-node imports remain limited to the same configured S3 bucket.
BACKUP_IMPORT_SOURCES=runtime1,runtime2
BACKUP_IMPORT_JOBS=/opt/e2b-runtime/backup/import-jobs
